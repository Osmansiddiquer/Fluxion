{
  "name": "ode-plotter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A Desmos-like grapher specialized for plotting numerical solutions of ODEs.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fluxion": "vite-node src/cli/main.ts --",
    "examples": "vite-node scripts/gen-examples.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@types/katex": "^0.16.8",
    "katex": "^0.17.0",
    "mathjs": "^14.0.1",
    "mathlive": "^0.110.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.20",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.12",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^3.2.7"
  }
}
