{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osmansiddiquer.github.io/Fluxion/fluxion-spec.schema.json",
  "title": "Fluxion graph spec",
  "description": "A graph for Fluxion (https://osmansiddiquer.github.io/Fluxion/). Put it in a link as #spec=<percent-encoded or base64url JSON> or #z=<base64url(deflate-raw(JSON))>. Expression syntax: https://osmansiddiquer.github.io/Fluxion/llms.txt",
  "type": "object",
  "required": ["expressions"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1, "description": "Spec format version." },
    "expressions": {
      "type": "array",
      "maxItems": 100,
      "description": "One entry per row in the app, in order.",
      "items": {
        "oneOf": [{ "$ref": "#/$defs/exprString" }, { "$ref": "#/$defs/expression" }]
      }
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "description": "Visible window. x is the horizontal axis. The grid is always square: xmin/xmax are exact, the y-range is re-centred on (ymin+ymax)/2 to fit the window shape. Defaults: x -8..8, y -5..5.",
      "properties": {
        "xmin": { "$ref": "#/$defs/number" },
        "xmax": { "$ref": "#/$defs/number" },
        "ymin": { "$ref": "#/$defs/number" },
        "ymax": { "$ref": "#/$defs/number" }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "description": "Inspection markers shown on curves.",
      "properties": {
        "extrema": { "type": "boolean", "default": true },
        "xIntercepts": { "type": "boolean", "default": true },
        "yIntercept": { "type": "boolean", "default": true },
        "endpoints": { "type": "boolean", "default": false },
        "discontinuities": { "type": "boolean", "default": true },
        "intersections": { "type": "boolean", "default": true }
      }
    },
    "panels": {
      "type": "object",
      "additionalProperties": false,
      "description": "Linked cross-section panels.",
      "properties": {
        "right": { "type": "boolean", "default": true, "description": "Panel of every curve's value at x = sliceX." },
        "bottom": { "type": "boolean", "default": true, "description": "Panel of where each curve crosses y = sliceY." },
        "sliceX": { "$ref": "#/$defs/numberOrExpr", "default": 0 },
        "sliceY": { "$ref": "#/$defs/numberOrExpr", "default": 1 }
      }
    },
    "sigFigs": { "$ref": "#/$defs/number", "description": "Significant figures in labels, 1 to 12.", "default": 3 }
  },
  "$defs": {
    "exprString": {
      "type": "string",
      "maxLength": 1000,
      "description": "Plain-text expression, e.g. \"y = sin(x)\", \"y'' = -y\", \"k = 2\", \"x^2 + y^2 = 9\", \"r = 1 + cos(theta)\", \"y < x\", \"(1, 2)\"."
    },
    "number": {
      "description": "A finite number, or a constant expression string such as \"2pi\" or \"-pi/2\". |value| <= 1e9.",
      "oneOf": [
        { "type": "number" },
        { "type": "string", "maxLength": 100 }
      ]
    },
    "numberOrExpr": {
      "description": "A number, a constant like \"pi\", or an expression over sliders like \"k\".",
      "oneOf": [
        { "type": "number" },
        { "type": "string", "maxLength": 100 }
      ]
    },
    "expression": {
      "type": "object",
      "required": ["expr"],
      "additionalProperties": false,
      "properties": {
        "expr": { "$ref": "#/$defs/exprString" },
        "color": {
          "type": "string",
          "description": "\"#rrggbb\", \"#rgb\" or a palette name. Default: next unused palette colour.",
          "anyOf": [
            { "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$" },
            { "enum": ["red", "blue", "green", "purple", "orange", "black", "pink", "teal"] }
          ]
        },
        "hidden": { "type": "boolean", "default": false },
        "t0": { "$ref": "#/$defs/number", "description": "ODE: initial time (default 0)." },
        "ic": {
          "description": "ODE: initial state [y(t0), y'(t0), ...], one value per order (default [1, 0, ...]).",
          "oneOf": [
            { "$ref": "#/$defs/number" },
            { "type": "array", "minItems": 1, "maxItems": 10, "items": { "$ref": "#/$defs/number" } }
          ]
        },
        "min": { "$ref": "#/$defs/number", "description": "Slider: minimum." },
        "max": { "$ref": "#/$defs/number", "description": "Slider: maximum." },
        "step": { "$ref": "#/$defs/number", "description": "Slider: step (> 0)." },
        "anim": { "enum": ["loop", "bounce", "once"], "description": "Slider: play-button mode." },
        "speed": { "type": "number", "minimum": 0.1, "maximum": 5, "description": "Slider: play speed." },
        "thetaMin": { "$ref": "#/$defs/number", "description": "Polar curve/region: start angle (default 0)." },
        "thetaMax": { "$ref": "#/$defs/number", "description": "Polar curve/region: end angle (default 2pi; at most 50 turns from thetaMin)." },
        "label": { "type": "string", "maxLength": 100, "description": "Point: label (LaTeX)." },
        "labelDir": { "enum": ["n", "ne", "e", "se", "s", "sw", "w", "nw"], "description": "Point: label direction." },
        "pointSize": { "type": "number", "minimum": 2, "maximum": 14, "description": "Point: marker radius in px." },
        "drag": { "enum": ["auto", "off", "x", "y", "both"], "description": "Point: drag behaviour." }
      }
    }
  }
}
